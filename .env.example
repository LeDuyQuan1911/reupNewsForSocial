# Copy this file to .env in the repo root and edit that local file.
# The dashboard and Hermes scripts load .env automatically. Never commit real values.
REUP_LLM_BASE_URL=http://127.0.0.1:20128/v1
REUP_LLM_MODEL=ag/gemini-3.8-flash-low
REUP_LLM_VISION_MODEL=ag/gemini-3.8-flash-low
REUP_LLM_IMAGE_MODEL=ag/gemini-3.1-flash-image
REUP_LLM_API_KEY=your-local-router-key
# Optional when Hermes is not installed at its default Windows path or on PATH.
# REUP_HERMES_BIN=path-to-hermes-executable
# Keep disabled while moving the scheduler from the old machine to the server.
REUP_AUTO_ENABLED=0
# Optional: enable Hermes web research in addition to configured RSS/GitHub sources.
REUP_HERMES_DISCOVERY_ENABLED=1
REUP_FACEBOOK_PAGE_ID=your-page-id
# page_token (legacy) or system_user; System User is preferred for unattended operation.
REUP_FACEBOOK_AUTH_MODE=system_user
REUP_FACEBOOK_SYSTEM_USER_TOKEN=your-system-user-token
# Only used when REUP_FACEBOOK_AUTH_MODE=page_token.
REUP_FACEBOOK_PAGE_TOKEN=your-page-access-token
REUP_META_GRAPH_VERSION=vXX.X
REUP_SECRET_KEY=replace-with-a-random-secret
